/**
 * Core Philosophy:
 * This ruleset establishes a collaborative, role-based security model for the
 * M.C & SONS FISH COMPANY billing system. The primary goal is to allow all
 * authenticated employees to manage core business data (customers, products, bills)
 * while reserving administrative privileges for managing users and system-level
 * data. A special `/roles_admin` collection governs administrative access,
 * providing a single, performant source of truth for authorization checks.
 *
 * Data Structure:
 * The data is organized into top-level collections for major entities like
 * `customers`, `products`, `users`, and `bills`. Bill items are stored in a
 * subcollection (`/bills/{billId}/billItems`). This flat structure simplifies
 * rules and queries. Archived bills are segregated into `/billArchives` to
 * separate active and inactive data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * Checks for ownership on an existing document. Used for update/delete.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Checks if the requesting user is an administrator via the high-performance
     * roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * A robust check for business roles (Creator, Admin, or Manager).
     * Combines the fast exists() check with a fallback to the user document.
     */
    function isAuthorizedStaff() {
      return isSignedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MANAGER', 'ADMIN', 'CREATOR']
      );
    }

    /**
     * Checks specifically for elevated privileges (Creator or Admin).
     */
    function isCreatorOrAdmin() {
      return isSignedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'CREATOR']
      );
    }

    /**
     * Ensures an immutable relationship field on update.
     */
    function isImmutable(fieldName) {
      return !(fieldName in request.resource.data) || request.resource.data[fieldName] == resource.data[fieldName];
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) || isCreatorOrAdmin();
      allow update: if isOwner(userId) || isCreatorOrAdmin();
      allow delete: if isCreatorOrAdmin();
    }

    match /products/{productId} {
      allow read, write: if isSignedIn();
    }
    
    match /payments/{paymentId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAuthorizedStaff();
    }

    match /customerBalances/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /productPrices/{productPriceId} {
      allow read, write: if isSignedIn();
    }

    match /uoms/{uomId} {
      allow read, write: if isSignedIn();
    }

    match /bills/{billId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(request.resource.data.createdBy) || isAuthorizedStaff());
      allow update: if isSignedIn() && (isExistingOwner(resource.data.createdBy) || isAuthorizedStaff()) && isImmutable('createdBy');
      allow delete: if isAuthorizedStaff() || isExistingOwner(resource.data.createdBy);

      match /billItems/{billItemId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.billId == billId && (isOwner(request.resource.data.addedBy) || isAuthorizedStaff());
        allow update: if (isExistingOwner(resource.data.addedBy) || isAuthorizedStaff()) && isImmutable('addedBy') && isImmutable('billId');
        allow delete: if isAuthorizedStaff() || isExistingOwner(resource.data.addedBy);
      }
    }

    match /billArchives/{billId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isCreatorOrAdmin();
    }

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, update, delete: if isCreatorOrAdmin();
      allow create: if (isOwner(userId) && request.auth.token.email == 'creator@mcandsons.com') || isCreatorOrAdmin();
    }
    
    match /vehicles/{vehicleId} {
      allow read, write: if isSignedIn();
    }

    match /drivers/{driverId} {
      allow read, write: if isSignedIn();
    }

    match /parties/{partyId} {
        allow read, write: if isSignedIn();
    }

    match /vehicleBills/{vehicleBillId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(request.resource.data.createdBy) || isAuthorizedStaff());
      allow update: if (isExistingOwner(resource.data.createdBy) || isAuthorizedStaff()) && isImmutable('createdBy');
      allow delete: if isAuthorizedStaff() || isExistingOwner(resource.data.createdBy);
    }

    match /partyBills/{partyBillId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(request.resource.data.createdBy) || isAuthorizedStaff());
      allow update: if (isExistingOwner(resource.data.createdBy) || isAuthorizedStaff()) && isImmutable('createdBy');
      allow delete: if isAuthorizedStaff() || isExistingOwner(resource.data.createdBy);
    }
    
    match /partyBalances/{partyId} {
      allow read, write: if isSignedIn();
    }

    match /statementPrintHistory/{recordId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isCreatorOrAdmin();
    }
  }
}